{
  "name": "pi-codemode-extension",
  "version": "0.2.0",
  "type": "module",
  "description": "Pi extension that adds an exec tool for orchestrating Pi tools with JavaScript, plus a /codeMode command to toggle it.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "exec"
  ],
  "license": "MIT",
  "author": "Hor1zonZzz <hor1zonlin9n@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hor1zonZzz/pi-codeMode.git"
  },
  "homepage": "https://github.com/Hor1zonZzz/pi-codeMode#readme",
  "bugs": {
    "url": "https://github.com/Hor1zonZzz/pi-codeMode/issues"
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/code-mode.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@earendil-works/pi-tui": "^0.75.3",
    "@types/node": "^24.10.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  }
}
